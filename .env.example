# Example environment for SageRoute.
# This file is not auto-loaded. Source it yourself or pass these variables through your
# process manager, shell, or container runtime.

# Levanto Sage API key. Required for live Sage decisions and examples/live-e2e.ts.
SAGE_API_KEY=lv_your_sage_key_here

# Provider API keys referenced by sageroute.config.example.json.
# Only the providers your ladder actually names are required; the validator fails at
# startup on a "${VAR}" reference whose variable is unset, so drop the providers you
# do not use from the config rather than exporting placeholder keys for them.
# API keys are also optional for a provider configured with authMode "oauth"; in that
# case, remove apiKey from the provider config and run sageroute auth login <provider>.
OPENAI_API_KEY=sk_your_openai_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
XAI_API_KEY=xai-your_xai_key_here
KIMI_API_KEY=sk-your_moonshot_key_here

# Optional config path. The CLI falls back to ./sageroute.config.json when unset.
SAGEROUTE_CONFIG=./sageroute.config.json
